rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validReservation(data, reservationId) {
      return data.keys().hasAll([
          'id', 'name', 'date', 'startTime',
          'duration', 'printerId'
        ])
        && data.id is string
        && data.id == reservationId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 50
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startTime is string
        && data.startTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.duration is string
        && data.duration.matches('^[0-9]{2}:[0-9]{2}$')
        && data.printerId in ['printer-1', 'printer-2', 'printer-3']
        && (!('purpose' in data) || (data.purpose is string && data.purpose.size() <= 200))
        && (!('message' in data) || (data.message is string && data.message.size() <= 1000))
        && (!('color' in data) || (data.color is string && data.color.size() <= 30))
        && (!('emoji' in data) || (data.emoji is string && data.emoji.size() <= 20))
        && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128))
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 50));
    }

    match /reservations/{reservationId} {
      // 誰でも閲覧・登録・削除可能（アカウント不要）
      allow read: if true;
      allow create: if validReservation(request.resource.data, reservationId);
      allow update: if false;
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
